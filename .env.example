# OpenAI — optional server-side fallback (UI password field preferred for shared deploys)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: higher GitHub API rate limits
# GITHUB_TOKEN=ghp_...

# Prefer recent research papers (fewer broken legacy APIs)
MIN_PAPER_YEAR=2021

# Optional: Semantic Scholar key (higher rate limits)
# https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=

# ReAct / researcher budget
MAX_AGENT_STEPS=8
CHARS_PER_PAGE=4000

# Multi-agent team (Planner → Researcher → Writer → Critic)
MAX_TEAM_ROUNDS=2

# Experiment runner (local Docker only)
RUN_TIMEOUT_SEC=600

# Gradio (local)
GRADIO_SERVER_PORT=7860
